// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & USERS
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  role          UserRole  @default(ADMIN)
  passwordHash  String    @map("password_hash")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  lotsCreated         Lot[]               @relation("LotCreatedBy")
  inventoryMovements  InventoryMovement[] @relation("MovementCreatedBy")
  qcChecks            QCCheck[]           @relation("QCCheckedBy")
  salesCreated        Sale[]              @relation("SaleCreatedBy")

  @@map("users")
}

enum UserRole {
  ADMIN
  ALMACEN
  CALIDAD
  VENTAS
}

// ============================================
// CUSTOMERS
// ============================================

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  city      String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  sales Sale[]

  @@map("customers")
}

// ============================================
// SELLERS
// ============================================

model Seller {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  email          String?
  commissionRate Float    @default(0.0) @map("commission_rate")
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("sellers")
}

// ============================================
// PRODUCTS
// ============================================

model Category {
  id             String   @id @default(cuid())
  name           String   @unique
  pricePerGram   Float    @default(10.0) @map("price_per_gram")
  defaultMargin  Float    @map("default_margin")
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  productBases ProductBase[]

  @@map("categories")
}

model ProductBase {
  id          String   @id @default(cuid())
  name        String
  categoryId  String   @map("category_id")
  photoUrl    String?  @map("photo_url")
  skuRoot     String   @unique @map("sku_root")
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  category Category          @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]

  @@map("product_bases")
}

model ProductVariant {
  id                String   @id @default(cuid())
  productBaseId     String   @map("product_base_id")
  gramWeightG       Int      @map("gram_weight_g")
  sku               String   @unique
  barcode           String?
  photoUrl          String?  @map("photo_url")
  pricePerUnit      Float    @default(0) @map("price_per_unit")
  marginOverride    Float?   @map("margin_override")
  manualPriceCents  Int?     @map("manual_price_cents")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  productBase ProductBase @relation(fields: [productBaseId], references: [id])
  lots        Lot[]
  saleLines   SaleLine[]

  @@unique([productBaseId, gramWeightG])
  @@map("product_variants")
}

// ============================================
// INVENTORY
// ============================================

model InventoryLocation {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  lots Lot[]

  @@map("inventory_locations")
}

model Lot {
  id                 String    @id @default(cuid())
  code               String    @unique
  productVariantId   String    @map("product_variant_id")
  productionDate     DateTime  @map("production_date")
  expiryDate         DateTime  @map("expiry_date")
  unitsInitial       Int       @map("units_initial")
  unitsOnHand        Int       @map("units_on_hand")
  costPerUnitCents   Int       @map("cost_per_unit_cents")
  status             LotStatus @default(APPROVED)
  locationId         String?   @map("location_id")
  notes              String?
  createdById        String    @map("created_by_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  productVariant     ProductVariant      @relation(fields: [productVariantId], references: [id])
  location           InventoryLocation?  @relation(fields: [locationId], references: [id])
  createdBy          User                @relation("LotCreatedBy", fields: [createdById], references: [id])
  inventoryMovements InventoryMovement[]
  qcChecks           QCCheck[]
  saleLineLots       SaleLineLot[]
  notifications      NotificationLog[]

  @@index([expiryDate])
  @@index([productVariantId])
  @@map("lots")
}

enum LotStatus {
  APPROVED
  HOLD
  REJECTED
}

model InventoryMovement {
  id            String               @id @default(cuid())
  lotId         String               @map("lot_id")
  type          InventoryMovementType
  quantityUnits Int                  @map("quantity_units")
  referenceType ReferenceType?       @map("reference_type")
  referenceId   String?              @map("reference_id")
  notes         String?
  createdById   String               @map("created_by_id")
  createdAt     DateTime             @default(now()) @map("created_at")

  // Relations
  lot       Lot  @relation(fields: [lotId], references: [id])
  createdBy User @relation("MovementCreatedBy", fields: [createdById], references: [id])

  @@index([lotId])
  @@map("inventory_movements")
}

enum InventoryMovementType {
  PRODUCTION_IN
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  EXPIRATION_OUT
}

enum ReferenceType {
  SALE
  PURCHASE
  ADJUSTMENT
  SYSTEM
}

// ============================================
// QUALITY CONTROL
// ============================================

model QCCheck {
  id          String    @id @default(cuid())
  lotId       String    @map("lot_id")
  brix        Float?
  ph          Float?
  temperature Float?
  status      QCStatus
  notes       String?
  checkedById String    @map("checked_by_id")
  checkedAt   DateTime  @default(now()) @map("checked_at")

  // Relations
  lot       Lot  @relation(fields: [lotId], references: [id])
  checkedBy User @relation("QCCheckedBy", fields: [checkedById], references: [id])

  @@map("qc_checks")
}

enum QCStatus {
  APPROVED
  OBSERVED
  REJECTED
}

// ============================================
// SALES
// ============================================

model Sale {
  id              String        @id @default(cuid())
  saleNumber      String        @unique @map("sale_number")
  occurredAt      DateTime      @default(now()) @map("occurred_at")
  customerId      String?       @map("customer_id")
  channel         SaleChannel   @default(MANUAL)
  paymentMethod   PaymentMethod @map("payment_method")
  status          SaleStatus    @default(COMPLETED)
  totalAmountCents Int          @map("total_amount_cents")
  currency        String        @default("COP")
  dueDate         DateTime?     @map("due_date")
  paidAt          DateTime?     @map("paid_at")
  notes           String?
  createdById     String        @map("created_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  customer  Customer?  @relation(fields: [customerId], references: [id])
  createdBy User       @relation("SaleCreatedBy", fields: [createdById], references: [id])
  saleLines SaleLine[]

  @@index([occurredAt])
  @@map("sales")
}

enum SaleChannel {
  MANUAL
  WHATSAPP
}

enum PaymentMethod {
  CASH
  NEQUI
  BANCOLOMBIA
  CREDIT
}

enum SaleStatus {
  COMPLETED
  VOID
}

model SaleLine {
  id               String   @id @default(cuid())
  saleId           String   @map("sale_id")
  productVariantId String   @map("product_variant_id")
  quantityUnits    Int      @map("quantity_units")
  unitPriceCents   Int      @map("unit_price_cents")
  discountCents    Int      @default(0) @map("discount_cents")
  subtotalCents    Int      @map("subtotal_cents")

  // Relations
  sale           Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productVariant ProductVariant  @relation(fields: [productVariantId], references: [id])
  saleLineLots   SaleLineLot[]

  @@map("sale_lines")
}

model SaleLineLot {
  id                    String @id @default(cuid())
  saleLineId            String @map("sale_line_id")
  lotId                 String @map("lot_id")
  quantityUnits         Int    @map("quantity_units")
  costUnitCentsAtSale   Int    @map("cost_unit_cents_at_sale")

  // Relations
  saleLine SaleLine @relation(fields: [saleLineId], references: [id], onDelete: Cascade)
  lot      Lot      @relation(fields: [lotId], references: [id])

  @@map("sale_line_lots")
}

// ============================================
// NOTIFICATIONS
// ============================================

model NotificationLog {
  id           String             @id @default(cuid())
  type         NotificationType
  lotId        String?            @map("lot_id")
  scheduledFor DateTime           @map("scheduled_for")
  sentAt       DateTime?          @map("sent_at")
  recipient    String
  channel      NotificationChannel
  status       NotificationStatus @default(QUEUED)
  error        String?
  createdAt    DateTime           @default(now()) @map("created_at")

  // Relations
  lot Lot? @relation(fields: [lotId], references: [id])

  @@index([type, lotId, scheduledFor])
  @@map("notification_logs")
}

enum NotificationType {
  PRE_EXPIRY
  EXPIRED
  LOW_STOCK
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

// ============================================
// SETTINGS
// ============================================

model Settings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
